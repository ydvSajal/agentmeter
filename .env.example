# Copy to .env (git-ignored). Never commit real values. Never expose these to apps/web client code.

# --- Adapters: fake until each real adapter lands (see docs/ARCHITECTURE.md §6) ---
ADAPTERS=fake            # fake | real
# per-port overrides (optional): FACILITATOR=real DECIDER=real EPISODES=real AUDIT=real STEPUP=real

# --- Hedera ---
HEDERA_NETWORK=testnet
HEDERA_OPERATOR_ID=0.0.x
HEDERA_OPERATOR_KEY=              # DER, pays HCS fees
HEDERA_PAYTO_ACCOUNT_ID=0.0.x     # device owner revenue account
HEDERA_HCS_TOPIC_ID=0.0.x
HEDERA_USDC_TOKEN_ID=0.0.429274   # testnet USDC (verify)
X402_FACILITATOR_URL=https://x402.org/facilitator   # or https://api.testnet.blocky402.com

# --- Agent (separate payer account) ---
AGENT_HEDERA_ACCOUNT_ID=0.0.x
AGENT_HEDERA_PRIVATE_KEY=         # DER

# --- 0G ---
ZG_COMPUTE_BASE_URL=https://router-api.0g.ai/v1
ZG_COMPUTE_API_KEY=               # from https://pc.0g.ai
ZG_MODEL=                         # pick from https://pc.0g.ai/models
ZG_STORAGE_RPC=
ZG_STORAGE_INDEXER=
ZG_PRIVATE_KEY=                   # funded via https://faucet.0g.ai
ZG_TIMEOUT_MS=4000

# --- World ID (OIDC) ---
WORLD_OIDC_ISSUER=                # from https://auth.world.org/.well-known/openid-configuration
WORLD_CLIENT_ID=
WORLD_CLIENT_SECRET=
WORLD_REDIRECT_URI=http://localhost:3000/api/world/callback

# --- Gateway ---
# Neon: DATABASE_URL = pooled string (host has -pooler); DIRECT_URL = direct string (migrations only). AD034
PORT=8787
DATABASE_URL=
DIRECT_URL=
# Resend (AD035). Server only. Off until keys exist.
RESEND_API_KEY=
NOTIFY_ENABLED=false
NOTIFY_FROM=onboarding@resend.dev
NOTIFY_TO=
NOTIFY_TIMEOUT_MS=4000
# Render (AD036): set these in the Render dashboard, not here.
RECEIPT_SIGNING_KEY_ED25519=      # base64 32-byte seed, server only
STEP_UP_THRESHOLD_HBAR=2
ACK_TIMEOUT_MS=8000

# --- Web (browser-safe values only) ---
NEXT_PUBLIC_GATEWAY_URL=http://localhost:8787
