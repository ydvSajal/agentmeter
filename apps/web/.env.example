# Fixtures default on when no gateway is configured. Set 0 to use the real gateway (login required).
NEXT_PUBLIC_FIXTURES=1
# Use 127.0.0.1 (not localhost) so the login cookie is same-site with the dev server.
NEXT_PUBLIC_GATEWAY_URL=http://127.0.0.1:8787
# Optional server-only address for container or private-network callback forwarding.
# GATEWAY_SERVER_URL=http://gateway:8787
